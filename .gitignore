# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environment & local credentials
.env
.env.local
*.key

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# System & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log

# Generated static caches (previews/crops re-generated automatically)
backend/static/page_previews/*
backend/static/visual_crops/*
!backend/static/page_previews/.gitkeep
!backend/static/visual_crops/.gitkeep
